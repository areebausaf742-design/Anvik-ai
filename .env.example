# ---------------------------------------------------------------------------
# ANVIK — environment. Copy to .env.local for local development.
# Never commit a real key. .env.local is ignored by .gitignore.
# ---------------------------------------------------------------------------

# The ONE name for the Gemini key, used by every route (/api/ask, /api/chat,
# /api/code, /api/voice, /api/vision, /api/image). Get a free key at
# https://aistudio.google.com/app/apikey
# Without it: chat runs in demo mode, /api/ask answers from the corpus, and
# Code/Voice/Vision/Image return an honest "add a key" message.
GOOGLE_GENERATIVE_AI_API_KEY=

# Model overrides (optional). Both default to gemini-2.0-flash.
ANVIK_MODEL=
ANVIK_IMAGE_MODEL=

# The public origin, used by sitemap.xml, robots.txt, canonical metadata and
# share cards. Must be set in production or the sitemap will point at localhost.
NEXT_PUBLIC_SITE_URL=https://anvik.ai

# ---------------------------------------------------------------------------
# Optional: Supabase for durable storage. With these set, questions/answers are
# mirrored to Postgres (see the schema in lib/supabase.ts). Without them the
# store is in-memory + disk-when-writable, which never 500s on a read-only
# filesystem. Use the service-role key server-side only.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: likes/dislikes/corrections are mirrored to anvik_learning only when
# Supabase is configured. Without it, learning stays in the browser (the default).

# Optional: local JSON store location. Defaults to ./data, falls back to the OS
# temp dir, then to memory. Not needed in production.
ANVIK_DATA_DIR=
